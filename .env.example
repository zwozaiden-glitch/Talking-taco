# ---------------------------------------------------------------------------
# Discord
# ---------------------------------------------------------------------------
# Get this from https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=

# How the bot is triggered: mention | prefix | both
BOT_TRIGGER_MODE=both

# Prefix used when BOT_TRIGGER_MODE includes "prefix"
BOT_PREFIX=!taco

# Set to true to let the bot answer EVERY message in allowed channels
REPLY_TO_ALL_MESSAGES=false

# Optional allow/ignore lists (comma-separated channel IDs, no spaces needed)
# ALLOWED_CHANNEL_IDS=123456789012345678,987654321098765432
# IGNORED_CHANNEL_IDS=

# How many past exchanges to remember per channel
MEMORY_TURNS=12

# Minimum seconds between two requests from the same user
COOLDOWN_SECONDS=3

# ---------------------------------------------------------------------------
# Your AI API  (this is the "use my API later" part -- only these change)
# ---------------------------------------------------------------------------
# Which backend to talk to. Leave blank to auto-detect from AI_API_KEY.
#   gemini -> Google AI Studio keys ("AIzaSy..."), https://aistudio.google.com/apikey
#   openai -> any OpenAI-compatible endpoint
#   mock   -> no network, canned replies (no key needed)
AI_PROVIDER=gemini

# Your key. Gemini keys start with AIzaSy.
AI_API_KEY=

# Gemini (default endpoint; leave as-is):
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# "auto" = let the bot ask the API which models your key has and pick a fast one.
# Or name one: gemini-2.5-flash, gemini-2.5-pro, gemini-2.0-flash, ...
AI_MODEL=auto

# --- If you use OpenAI-compatible instead (AI_PROVIDER=openai) --------------
# It must expose POST {AI_BASE_URL}/chat/completions. Examples:
#   https://api.openai.com/v1
#   https://openrouter.ai/api/v1
#   https://api.groq.com/openai/v1
#   http://localhost:11434/v1          (Ollama)
#   https://my-own-server.com/v1       (yours)
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

AI_MAX_TOKENS=600
AI_TEMPERATURE=0.8
AI_TIMEOUT=60

# Gemini 2.5+ "thinking" budget. 0 = off (fast chat replies).
# Raise it (e.g. 512) if you want the bot to reason harder before answering.
AI_THINKING_BUDGET=0

# Leave blank to use the built-in personality, or write your own
# AI_SYSTEM_PROMPT=You are Taco, a cheerful AI in a Discord server. Keep answers short.
